# Empty = same-origin API (Vite proxies /api to port 3001 locally).
VITE_API_URL=
# Google is the default address picker. Enable Maps JavaScript API + Places UI Kit.
# Use a browser key restricted to your app origins and those APIs; never commit it.
VITE_GOOGLE_MAPS_API_KEY=
VITE_ADDRESS_SEARCH_PROVIDER=google
# Explicit keyless local/test alternative: VITE_ADDRESS_SEARCH_PROVIDER=photon
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Keyless demo endpoints for LOCAL evaluation; use your own/hosted endpoints for production.
GEOCODER_URL=https://photon.komoot.io/api/
GEODATA_URL=https://overpass-api.de/api/interpreter
VITE_COMMERCE_ENABLED=false
PORT=3001
DATABASE_URL=postgres://golfworld:golfworld@localhost:5432/golfworld

{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:google": "playwright test --config playwright.google.config.ts",
    "test:pwa": "pnpm build && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@golfworld/economy": "workspace:*",
    "@golfworld/shared": "workspace:*",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "@react-three/rapier": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
